{
  "name": "@draconis/tmml",
  "version": "0.1.0",
  "description": "Draconis Training Markup Languages - Parser, Validator, and Tools",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "dtml": "./dist/src/cli/dtml.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:examples": "node -r ts-node/register/transpile-only tests/examples.test.ts",
    "validate": "node -r ts-node/register/transpile-only tools/validate.ts",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "training",
    "triathlon",
    "xml",
    "swim",
    "run",
    "bike",
    "markup",
    "dtml",
    "drml",
    "dsml",
    "dcml",
    "dtir"
  ],
  "author": "Draconis Engineering",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "libxmljs2": "^0.37.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  },
  "allowScripts": {
    "libxmljs2@0.37.0": true
  }
}
