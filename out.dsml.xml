<?xml version="1.0" encoding="UTF-8"?>
<swimsession id="dsml_0000" xmlns="https://draconis.engineering/dtml/dsml">
    <config>
        <pool lengthMeters="25" laneWidthMeters="5" depthMeters="1.5"/>
        <gear paddles="true" fins="true" snorkel="true"/>
    </config>

    <presession>
        <bandWork durationMinutes="5" durationSeconds="300"/>
    </presession>

    <warmup>
        <drillset>
            <superman lengthMeters="100"/>
        </drillset>
    </warmup>

    <main>
        <repeat count="1">
            <freestyle lengthMeters="400" RPE="5" snorkel="true"/>
            <freestyle lengthMeters="200" RPE="8"/>
        </repeat>
    </main>

    <cooldown>
        <freestyle lengthMeters="200" paddles="true" fins="true" snorkel="true"/>
    </cooldown>

    <postsession>
        <sauna durationMinutes="15" durationSeconds="900"/>
    </postsession>

</swimsession>
